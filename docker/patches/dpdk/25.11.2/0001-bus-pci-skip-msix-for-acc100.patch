diff --git a/drivers/bus/pci/linux/pci_vfio.c b/drivers/bus/pci/linux/pci_vfio.c
index 242f567ed781..c25f40b6f4cd 100644
--- a/drivers/bus/pci/linux/pci_vfio.c
+++ b/drivers/bus/pci/linux/pci_vfio.c
@@ -36,0 +37,14 @@ EAL_REGISTER_TAILQ(rte_vfio_tailq)
+#define ACC100_VENDOR_ID	(0x8086)
+#define ACC100_PF_DEVICE_ID	(0x0d5c)
+#define ACC100_VF_DEVICE_ID	(0x0d5d)
+
+static bool
+pci_vfio_is_acc100(const struct rte_pci_device *dev)
+{
+	if (dev->id.vendor_id != ACC100_VENDOR_ID)
+		return false;
+
+	return dev->id.device_id == ACC100_PF_DEVICE_ID ||
+		dev->id.device_id == ACC100_VF_DEVICE_ID;
+}
+
@@ -173,0 +188 @@ pci_vfio_setup_interrupts(struct rte_pci_device *dev, int vfio_dev_fd)
+	bool skip_msix;
@@ -180,0 +196,4 @@ pci_vfio_setup_interrupts(struct rte_pci_device *dev, int vfio_dev_fd)
+	skip_msix = pci_vfio_is_acc100(dev);
+	if (skip_msix && intr_mode == RTE_INTR_MODE_MSIX)
+		intr_mode = RTE_INTR_MODE_MSI;
+
@@ -206,0 +226,4 @@ pci_vfio_setup_interrupts(struct rte_pci_device *dev, int vfio_dev_fd)
+		/* ACC100 PF/VF should fall back to MSI instead of using MSI-X. */
+		if (skip_msix && i == VFIO_PCI_MSIX_IRQ_INDEX)
+			continue;
+
